# Copy this file to `.env` and fill in your key, then the tutorials pick it up
# automatically (via python-dotenv).

# Required for almost every metric (they use an OpenAI model as the LLM judge).
OPENAI_API_KEY=sk-your-key-here

# Optional: only if you ran `deepeval login` to use the Confident AI dashboard.
# CONFIDENT_API_KEY=

# Optional: write local JSON result files to this folder instead of the cloud.
# DEEPEVAL_RESULTS_FOLDER=./results
